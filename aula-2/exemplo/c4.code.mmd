classDiagram
  class Loan {
    - id
    - book
    - dueDate
    - returnDate
    - loanDate
    + loan(book, user, dueDate, returnDate, loanDate)
    + renew(newDueDate, user, dueDate)
    + return()
    + isOverDue()
  }

  class Notification {
    <<interface>>
    + notify(loan)
  }

  class EmailNotifier {
    + notify(loan)
  }

  Loan --> Notification : usa
  EmailNotifier ..|> Notification : implementa